# OneKhusa API Credentials (sandbox)
ONEKHUSA_API_KEY=
ONEKHUSA_API_SECRET=
ONEKHUSA_ORG_ID=
ONEKHUSA_MERCHANT_NUMBER=

# Get Access Token endpoint - returns JWT used as 'Authorization: Bearer <token>'
ONEKHUSA_TOKEN_URL=https://api.onekhusa.com/sandbox/v1/account/getAccessToken

# Hosted checkout initiate endpoint - returns paymentTransactionId
ONEKHUSA_CHECKOUT_URL=https://api.onekhusa.com/sandbox/v1/checkout/rtp/initiate

# Hosted checkout page (redirect target after successful initiation)
ONEKHUSA_CHECKOUT_REDIRECT_URL=https://checkout.onekhusa.com/requestToPay/initiate

# Webhook signing secret used to verify inbound callbacks (HMAC-SHA512).
# Found in the OneKhusa portal webhook settings — separate from the API secret.
# Required: /webhooks/payments rejects unverified requests.
ONEKHUSA_WEBHOOK_SECRET=

# Publicly reachable URL (e.g. your ngrok tunnel) used for redirects + webhooks
PUBLIC_CALLBACK_URL=

# Server
PORT=3000
